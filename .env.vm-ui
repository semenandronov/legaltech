# UI surface for Yandex VM production builds.
# Merged into .env.vite-build by scripts/lib/deploy-common.sh (overrides same keys from .env).
# Local dev: leave this file as-is; full surface stays on when flags are unset in .env.

# Глобальный ассистент (/assistant) — скрыт; старт с /cases
VITE_FEATURE_GLOBAL_ASSISTANT=false
# Внутренний ассистент по делу (/cases/:id/chat) — скрыт для юристов
VITE_FEATURE_CASE_ASSISTANT=false
# Страница и маршруты «Операций» полностью скрыты
VITE_FEATURE_OPERATIONS_PAGE=false
# Ассистент на странице Операций — agent-first разбор выписки
VITE_FEATURE_OPERATIONS_ASSISTANT=false

# Чат: тумблеры включены; страницы и сайдбар — скрыты
VITE_FEATURE_LEGAL_CORPUS=true
VITE_FEATURE_LEGAL_CORPUS_PAGES=false
VITE_FEATURE_COURT_PRACTICE=true
VITE_FEATURE_COURT_PRACTICE_PAGES=false
VITE_FEATURE_DRAFT_TEMPLATES=false
VITE_FEATURE_DRAFT_MODE=false
VITE_FEATURE_EDITOR=false
VITE_FEATURE_PLAYBOOKS=false
VITE_FEATURE_AGENT_RUNS=false
VITE_AGENT_RUNS_ENABLED=false
VITE_FEATURE_CHUNK_LAB=false
