# Dockerfile for LangGraph Platform deployment
# Based on LangGraph CLI requirements

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Только ядро (без Docling/PyTorch) — быстрее сборка образа LangGraph
COPY requirements-core.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-core.txt

# Install LangGraph CLI
RUN pip install --no-cache-dir langgraph-cli

# Copy application code
COPY . .

# Set environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose port for LangGraph server
EXPOSE 8123

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8123/health || exit 1

# Run LangGraph server
CMD ["langgraph", "serve", "--host", "0.0.0.0", "--port", "8123"]

