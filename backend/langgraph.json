{
  "$schema": "https://langchain-ai.github.io/langgraph/schemas/langgraph.json",
  "version": "1.0",
  "graphs": {
    "chat": {
      "path": "app/services/langchain_agents/graphs/chat_graph.py:create_chat_graph",
      "description": "Chat graph for legal assistant conversations",
      "config": {
        "use_checkpointing": true,
        "enable_memory_management": true
      }
    },
    "tabular": {
      "path": "app/services/langchain_agents/graphs/tabular_graph.py:create_tabular_graph",
      "description": "Tabular extraction graph for document data extraction",
      "config": {
        "use_checkpointing": true,
        "use_send_api": true
      }
    },
    "workflow": {
      "path": "app/services/langchain_agents/graphs/workflow_graph.py:create_workflow_graph",
      "description": "Workflow orchestration graph for complex multi-step tasks",
      "config": {
        "use_checkpointing": true,
        "use_send_api": true
      }
    }
  },
  "assistants": {
    "legal-assistant": {
      "graph": "chat",
      "name": "Legal AI Assistant",
      "description": "General-purpose legal assistant for case analysis and document review",
      "metadata": {
        "mode": "normal",
        "enable_garant": true
      }
    },
    "deep-analyst": {
      "graph": "chat",
      "name": "Deep Legal Analyst",
      "description": "In-depth legal analysis with step-by-step reasoning",
      "metadata": {
        "mode": "deep_think",
        "enable_garant": true
      }
    },
    "document-drafter": {
      "graph": "chat",
      "name": "Document Drafter",
      "description": "Legal document drafting assistant",
      "metadata": {
        "mode": "draft",
        "enable_garant": false
      }
    },
    "tabular-extractor": {
      "graph": "tabular",
      "name": "Tabular Data Extractor",
      "description": "Extract structured data from documents into tables",
      "metadata": {
        "confidence_threshold": 0.8,
        "enable_hitl": true
      }
    },
    "workflow-orchestrator": {
      "graph": "workflow",
      "name": "Workflow Orchestrator",
      "description": "Execute complex multi-step legal workflows",
      "metadata": {
        "require_approval": true,
        "auto_adapt": true
      }
    }
  },
  "env": {
    "LANGCHAIN_TRACING_V2": "true",
    "LANGCHAIN_PROJECT": "legal-ai-vault"
  },
  "dependencies": [
    "langchain>=0.1.0",
    "langgraph>=0.0.40",
    "langchain-openai>=0.0.5",
    "pydantic>=2.0.0",
    "sqlalchemy>=2.0.0",
    "psycopg2-binary>=2.9.0"
  ],
  "python_version": "3.11",
  "dockerfile": "Dockerfile.langgraph"
}

