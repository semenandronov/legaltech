# Database
# Без ?schema= — иначе psycopg2 даёт «invalid connection option schema» (это не DSN-параметр).
DATABASE_URL="postgresql://user:password@localhost:5432/legal_ai"
# Пул SQLAlchemy (по умолчанию 10/20/60с; при SSE + нагрузке увеличьте при необходимости)
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
# SQLALCHEMY_POOL_TIMEOUT=60

# Зависшие файлы при старте (pending/processing → error). На Yandex Serverless с несколькими
# контейнерами глобальный сброс ломает чужую обработку — отключите или задайте «возраст»:
# RESET_STUCK_FILES_ON_STARTUP=false
# Либо сбрасывать только записи старше N минут (по COALESCE(processing_started_at, created_at)):
# STUCK_FILE_RESET_MIN_AGE_MINUTES=60

# --- Два контейнера (API + worker), один Docker-образ ---
# API (legaltech): оставьте APP_ROLE=api или не задавайте
# APP_ROLE=api
# WORKER_BASE_URL=https://<id>.containers.yandexcloud.net   # URL worker-контейнера
# INTERNAL_WORKER_SECRET=<случайная длинная строка>         # одинаково на API и worker
# FILE_PROCESSING_MODE=auto   # auto | local | worker
# Параллельная обработка (file_processor_bg + file_ingest_scheduler + семафоры)
FILE_PROCESSING_MAX_PARALLEL_FILES=4
FILE_PROCESSING_MAX_PARALLEL_PASSPORT=3
FILE_PROCESSING_MAX_PARALLEL_EMBEDDINGS=2
FILE_PROCESSING_MAX_CONCURRENT_CASES=2
# На слабой VM: FILES=2, EMBEDDINGS=1, CONCURRENT_CASES=1
# WORKER_DISPATCH_TIMEOUT_SEC=30
#
# Хранение оригиналов дел: по умолчанию только диск (быстрый commit без BYTEA в Neon).
# Локально:
# UPLOAD_DIR=./uploads
# FILE_STORE_BYTES_IN_DB=false
#
# Google Drive import (frontend Picker + backend download into case)
# GCP: enable Drive API + Picker API; OAuth Web client + API key (referrer-restricted)
# В корневом .env (Vite envDir = корень репозитория). Обязательны для production build:
# VITE_GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# VITE_GOOGLE_API_KEY=AIza...
# GOOGLE_DRIVE_IMPORT_MAX_FILES=30
# Production deploy (Mac → Yandex CR → VM, кэш слоёв в registry):
#   ./scripts/deploy-prod.sh
# Только .env на VM без пересборки UI: ./scripts/deploy-prod.sh --env-only
# Сборка на VM (fallback): ./scripts/deploy-prod.sh --build-on-vm
# Один контейнер на Yandex VM (volume в vm-restart-legal-ai.sh):
#   на ВМ: mkdir -p /home/andronovsemen04/legal-ai/uploads
#   UPLOAD_DIR=/app/backend/uploads
#   FILE_STORE_BYTES_IN_DB=false
# API + worker без общего тома: FILE_STORE_BYTES_IN_DB=true или общий UPLOAD_DIR/S3.
# WORKER_DISPATCH_USE_METADATA_IAM=true   # Bearer из metadata SA (обязательно в Yandex для invoker)
#
# Worker (legaltech-worker): команда uvicorn app.worker_app:app ...
# APP_ROLE=worker
# INTERNAL_WORKER_SECRET=<тот же секрет>
# RESET_STUCK_FILES_ON_STARTUP=false
# На API тоже: RESET_STUCK_FILES_ON_STARTUP=false (чтобы новый инстанс API не сбрасывал processing)
# В Yandex: выдайте сервисному аккаунту API роль serverless.containers.invoker на worker

# NextAuth / JWT (без кавычек в значениях — Docker --env-file передаёт "..." буквально)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production-min-32-characters
JWT_SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters

# CORS: Vite часто открывают как http://127.0.0.1:5173 — это другой origin, чем localhost
# CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# OpenAI (опционально - без ключа используются моки)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Yandex Cloud (опционально - для обработки изображений/аудио/видео)
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""
YANDEX_IAM_TOKEN=""
# Эмбеддинги: лимит ~2048 токенов Yandex; нарезка по tiktoken (cl100k_base) + буфер + нахлест сегментов.
# YANDEX_EMBEDDING_MAX_INPUT_CHARS=2800
# YANDEX_EMBEDDING_API_TOKEN_CAP=2048
# YANDEX_EMBEDDING_TOKEN_SAFETY_RATIO=0.85
# YANDEX_EMBEDDING_MAX_INPUT_TOKENS=0
# YANDEX_EMBEDDING_SEGMENT_OVERLAP_CHARS=150
# YANDEX_EMBEDDING_DOC_MODEL=text-search-doc/latest
# YANDEX_EMBEDDING_QUERY_MODEL=text-search-query/latest
# YANDEX_EMBEDDING_MAX_PARALLEL_REQUESTS=8
# YANDEX_EMBEDDING_MIN_REQUEST_INTERVAL_SEC=0.11
# Чанкинг справочника / Docling: LEGAL_SEGMENT_MAX_CHARS, LEGAL_TABLE_SHARD_MIN_CHARS, LEGAL_TABLE_SHARD_ROWS_PER_GROUP
# Табличные выписки (structured-table-v1): 1 строка таблицы = 1 чанк для RAG
# STRUCTURED_TABLE_INDEXING_ENABLED=true
# Production case assistant (planner + SQL + fast RAG):
# CASE_ASSISTANT_LEGACY_PIPELINE_ENABLED=false
# CASE_ASSISTANT_QUERY_PLANNER_ENABLED=true
# STRUCTURED_DATA_HTTP_PREP_ROUTER_ENABLED=true
# STRUCTURED_DATA_LLM_ROUTER_ENABLED=true
# STRUCTURED_TABLE_INDEXING_ENABLED=true
# CASE_ASSISTANT_DRAFT_GENERATION_MODEL=gpt://<folder-id>/yandexgpt-lite/latest
# STATEMENT_SQL_SYNTHESIS_MODEL=  # пусто = тот же lite, что и draft generation
# STATEMENT_TABLE_AGENT_ENABLED=true  # tool-calling агент по таблице выписки (primary)
# STATEMENT_TABLE_AGENT_MAX_TOOL_CALLS=8
# STATEMENT_TABLE_AGENT_MAX_TOKENS=2048
# CASE_ASSISTANT_RERANK_DEADLINE_MS=1200
#
# A/B: case chat как commit 0018729 (без SQL/hybrid router) — CASE_ASSISTANT_LEGACY_PIPELINE_ENABLED=true
# + STRUCTURED_DATA_HTTP_PREP_ROUTER_ENABLED=false STRUCTURED_DATA_LLM_ROUTER_ENABLED=false
# + CASE_FILE_TRANSACTIONS_ENABLED=false CASE_TRANSACTION_AGENT_ENABLED=false
# + FILE_SCOPED_AGENT_ENABLED=false TABULAR_STATEMENT_AGENT_ENABLED=false
# STRUCTURED_TABLE_MIN_CHAR_RATIO=0.45
# STRUCTURED_TABLE_MIN_ROWS=8
# STRUCTURED_TABLE_MIN_TABLE_SEGMENTS=1
# Native Excel statements → Operations (openpyxl grid → structured_table)
# XLSX_STRUCTURED_TABLE_ENABLED=true
# На небольших VM лучше отключить повторный Docling AST pre-segmentation и индексировать loader chunks.
# LEGAL_CHUNKING_DUAL_ENABLED=false
# LEGAL_CHUNK_EMBED_PREFIX_ENABLED=true
# LEGAL_CHUNK_COUNT_WARN_THRESHOLD=2000
# LLM: yandex | gigachat | ollama
# LLM_PROVIDER=yandex
# Для Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="gemma4"
# OLLAMA_API_KEY="ollama"
# Для Yandex:
# YANDEX_LLM_TRANSPORT=openai
# YANDEX_GPT_MODEL_URI=gpt://<folder-id>/qwen3.6-35b-a3b/latest
#
# Классификация текста (AI Studio, Foundation Models):
# https://aistudio.yandex.ru/docs/en/ai-studio/text-classification/api-ref/
# Дообученная модель: POST .../textClassification — задайте полный URI или folder + id:
# YANDEX_CLASSIFIER_MODEL_URI="cls://<folder-id>/<classifier>/latest"
# или YANDEX_AI_STUDIO_CLASSIFIER_ID="<suffix>" при заданном YANDEX_FOLDER_ID → cls://<folder>/<suffix>
# Стримить reasoning в SSE global-chat (только если модель реально отдаёт дельты в чанках)
# YANDEX_SSE_STREAM_MODEL_REASONING=false
# Промптовый классификатор (few-shot, до 20 классов): метод classify_few_shot в app/services/yandex_classifier.py

# File Upload (опционально)
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="pdf,docx,txt"

# Кто может загружать общий правовой справочник (ассистент), через запятую, lower-case email
LEGAL_CORPUS_UPLOADER_EMAILS="semenandronov2004@mail.ru"
# Судебная практика (КАД): загрузка CSV и управление базой
COURT_PRACTICE_UPLOADER_EMAILS="semenandronov2004@mail.ru"
# GigaChat EmbeddingsGigaR (2560) — отдельно от Yandex 256
GIGACHAT_CREDENTIALS=
# Локально (SberCA Ext / curl SSL error): false. В проде — true, если публичная цепочка CA.
GIGACHAT_VERIFY_SSL=false
GIGACHAT_EMBEDDING_MODEL=EmbeddingsGigaR
GIGACHAT_EMBEDDING_DIM=2560
GIGACHAT_EMBEDDING_BATCH_SIZE=8
GIGACHAT_EMBEDDING_MIN_INTERVAL_SEC=0.12
# Поиск по судебной практике
COURT_PRACTICE_VECTOR_RECALL_K=50
COURT_PRACTICE_FTS_RECALL_K=50
COURT_PRACTICE_RRF_K=60
COURT_PRACTICE_MAX_CHUNKS_PER_CASE=3
COURT_PRACTICE_FINAL_K=7
COURT_PRACTICE_USE_RERANKER=true
# Планировщик запросов (multi-query FTS, без доп. embeddings)
COURT_PRACTICE_LLM_PLANNER_ENABLED=true
# Опционально: отдельная модель для планировщика (иначе дефолт create_legal_llm)
# COURT_PRACTICE_LLM_PLANNER_MODEL=
COURT_PRACTICE_QUERY_PLANNER_MAX_QUERIES=6
COURT_PRACTICE_FTS_SUPPLEMENT_K=10
# Детальная иерархия spans в Langfuse (pipeline → embed → hybrid → fts → rerank)
COURT_PRACTICE_LANGFUSE_DETAILED=true
# Shortlist (сколько top-хитов hybrid идёт в cross-encoder rerank)
COURT_PRACTICE_RERANK_POOL_K=12
# Сколько символов/контекста передавать в bge-reranker (passage)
COURT_PRACTICE_RERANK_MAX_CHARS=2400
COURT_PRACTICE_CONTEXT_K=7
COURT_PRACTICE_MAX_CONTEXT_CHARS=28000
LEGAL_CORPUS_FORCE_ENABLED=false
# Устарело: не используется API — справочник в чате по делу только через тумблер (legal_research / use_legal_corpus).
LEGAL_CORPUS_AUTO_USE_IN_CASE_CHAT=false
# Справочник: пул до rerank (LEGAL_CORPUS_RECALL_MAX), rerank (LEGAL_CORPUS_USE_RERANKER), модель — RERANKER_MODEL_NAME; на слабом CPU: LEGAL_CORPUS_USE_RERANKER=false
LEGAL_CORPUS_RECALL_MAX=30
LEGAL_CORPUS_FINAL_K=8
LEGAL_CORPUS_USE_RERANKER=true
# После article fast path с полным покрытием плана — не запускать cross-encoder rerank
LEGAL_CORPUS_SKIP_RERANK_ON_FAST_PATH=true
# light = CASE_ASSISTANT_RERANK_LIGHT_MODEL (ms-marco-MiniLM); heavy = RERANKER_MODEL_NAME (BGE)
LEGAL_CORPUS_RERANK_TIER=light
LEGAL_CORPUS_RERANK_MAX_CHARS=2400
LEGAL_CORPUS_HYBRID_PARALLEL=true
LEGAL_CORPUS_HYBRID_MAX_WORKERS=5
# Dense/sparse blend для norm-hybrid справочника (0.7 = 70% vector, 30% FTS)
LEGAL_CORPUS_HYBRID_ALPHA=0.7
# LEGAL_CORPUS_CONTEXT_K=8
# LEGAL_CORPUS_MAX_CONTEXT_CHARS=14000
# Глобальный ассистент: минимум слотов legal_corpus после merge с matter
# LEGAL_CORPUS_GLOBAL_MERGE_MIN_SLOTS=3
# LLM-интерпретатор запроса: переводит бытовой вопрос в юридические поисковые запросы
# перед первым поиском; ~3-5с задержки, минимальная стоимость (~200 токенов)
# GLOBAL_LEGAL_QUERY_INTERPRETER_ENABLED=true
# Глобальный ассистент: итеративный добор legal_corpus (LLM → доп. поиск → повторный merge)
# Второй проход retrieval по legal_corpus (follow-up queries); по умолчанию вкл (параллельный)
# GLOBAL_LEGAL_ITERATIVE_RETRIEVAL_ENABLED=true
# GLOBAL_LEGAL_ITERATIVE_MAX_QUERIES=3
# GLOBAL_LEGAL_ITERATIVE_K_PER_QUERY=6
# Budgeted legal retrieval agent (case chat / garant)
LEGAL_CORPUS_MAX_HYBRID_QUERIES=5
LEGAL_CORPUS_RETRIEVAL_WALL_MS=30000
# false если включён LLM planner (рекомендуется) — иначе дублирует interpreter
LEGAL_CORPUS_QUERY_INTERPRETER_ON_FIRST_PASS=false
LEGAL_CORPUS_EMBED_SYNONYM_HINTS_ENABLED=true
# Article-level chunking для Справочника (фаза A–E norm graph)
LEGAL_CORPUS_NORM_CHUNKING_ENABLED=true
LEGAL_CORPUS_NORM_MAX_ARTICLE_CHARS=12000
LEGAL_NORM_GRAPH_EXPAND_ENABLED=true
LEGAL_NORM_GRAPH_EXPAND_LIMIT=8
LEGAL_NORM_LLM_EXTRACTOR_ENABLED=false
# LEGAL_NORM_LLM_EXTRACTOR_MODEL=
# Agentic RAG: детерминированный coverage + merge с LLM-планом
LEGAL_CORPUS_AGENTIC_PLAN_ENABLED=true
# LLM анализирует вопрос и формирует search_queries до hybrid (основной путь)
LEGAL_CORPUS_LLM_PLANNER_ENABLED=true
LEGAL_CORPUS_LLM_PLANNER_MODEL=
LEGAL_CORPUS_LLM_PLANNER_MAX_QUERIES=6
# Включить LangGraph orchestrator для global assistant (multi-source RAG)
GLOBAL_ASSISTANT_LANGGRAPH_ENABLED=true
# Таймаут выполнения global-assistant LangGraph (сек)
GLOBAL_ASSISTANT_GRAPH_TIMEOUT_SEC=360
# Включить новый LangGraph runtime для in-case assistant (router + subgraphs)
CASE_ASSISTANT_GRAPH_V2_ENABLED=true
# Deep path (LangChain DeepAgents) для сложных маршрутов
CASE_ASSISTANT_DEEP_PATH_ENABLED=true
# Процент deep-трафика для запросов с depth_tier=deep (0..100)
CASE_ASSISTANT_DEEP_PATH_TRAFFIC_PERCENT=100
# Жёстко направлять все deep-tier запросы в DeepAgents (без canary-отсечки)
CASE_ASSISTANT_DEEP_FORCE_FOR_DEEP_TIER=true
# Shadow mode deep path (исполнять в фоне без отдачи результата)
CASE_ASSISTANT_DEEP_SHADOW_ENABLED=false
# Порог confidence для semantic override роутинга
CASE_ASSISTANT_ROUTE_SEMANTIC_OVERRIDE_THRESHOLD=0.78
# Порог confidence, ниже которого запрос уходит в clarification-safe path
CASE_ASSISTANT_ROUTE_CLARIFY_THRESHOLD=0.65
# Включить route-aware prompt profiles для non-draft in-case ответов
CASE_ASSISTANT_PROMPT_PROFILES_ENABLED=false
# Процент трафика на prompt profiles (0..100)
CASE_ASSISTANT_PROMPT_PROFILES_TRAFFIC_PERCENT=100
# Shadow mode для prompt profiles (считать профиль в фоне)
CASE_ASSISTANT_PROMPT_PROFILES_SHADOW_MODE=false
# Пошаговый прогресс в чате дела: этап + динамические детали из фактов пайплайна
CASE_ASSISTANT_STREAM_ACTIVITY_UI=true
# Показывать в чате дела блок «рассуждений» модели / статичные фазы графа (по умолчанию выкл.)
CASE_ASSISTANT_STREAM_REASONING_UI=false

# Case assistant context pipeline: Secretary → hybrid recall → bge-reranker → generate
CASE_ASSISTANT_CONTEXT_PIPELINE_ENABLED=true
# Secretary: LLM scope по каталогу при провале file-summary (не keyword-heuristics)
CASE_ASSISTANT_LLM_ROUTER_ENABLED=true
# FAST: cheap lite LLM picks file_ids from catalog when №-ref misses
CASE_ASSISTANT_FAST_LLM_FILE_SCOPE_ENABLED=true
CASE_ASSISTANT_ROUTER_MODEL=yandexgpt-lite/latest
CASE_ASSISTANT_ROUTER_MIN_CONFIDENCE=0.55
CASE_ASSISTANT_ROUTER_MAX_CATALOG_FILES=80
# Дела с <= N файлов: chunk search по всему делу без выбора документов
CASE_ASSISTANT_ROUTER_SMALL_CASE_MAX_FILES=5
# Deprecated: heuristic-first routing removed from secretary funnel
CASE_ASSISTANT_ROUTER_HEURISTIC_FIRST=false
CASE_ASSISTANT_ROUTER_HEURISTIC_MIN_CONFIDENCE=0.72
CASE_ASSISTANT_ROUTER_FULL_CASE_MIN_CONFIDENCE=0.72
CASE_ASSISTANT_ROUTER_LLM_MAX_FILES=0
CASE_ASSISTANT_CATALOG_CACHE_ENABLED=true
CASE_ASSISTANT_CATALOG_CACHE_TTL_SEC=600
CASE_ASSISTANT_DOC_COUNT_CACHE_ENABLED=true
CASE_ASSISTANT_DOC_COUNT_CACHE_TTL_SEC=300
CASE_ASSISTANT_INSTANT_MAX_CONTEXT_CHARS=3500
CASE_ASSISTANT_STANDARD_MAX_CONTEXT_CHARS=48000
CASE_ASSISTANT_DEEP_MAX_CONTEXT_CHARS=64000
CASE_ASSISTANT_MAX_CONTEXT_CHARS_CEILING=48000
CASE_ASSISTANT_INSTANT_MAX_TOKENS=300
CASE_ASSISTANT_FAST_GEN_MAX_CONTEXT_CHARS=3500
CASE_ASSISTANT_FAST_GEN_MAX_TOKENS=300
CASE_ASSISTANT_STANDARD_MAX_TOKENS=1500
CASE_ASSISTANT_DEEP_MAX_TOKENS=4500
CASE_ASSISTANT_INSTANT_TEMPERATURE=0.1
CASE_ASSISTANT_STANDARD_TEMPERATURE=0.2
CASE_ASSISTANT_DEEP_TEMPERATURE=0.3
# Hierarchical RAG step 1: hybrid index по паспорту файла (vector + FTS → dynamic K)
CASE_ASSISTANT_FILE_SUMMARY_INDEX_ENABLED=true
CASE_ASSISTANT_FILE_SUMMARY_MIN_SCORE=0.6
CASE_ASSISTANT_FILE_SUMMARY_SCORE_GAP=0.15
CASE_ASSISTANT_FILE_SUMMARY_RECALL_K=30
CASE_ASSISTANT_FILE_SUMMARY_MAX_FILES=20
CASE_ASSISTANT_FILE_SUMMARY_RELAXED_MIN_SCORE=0.35
CASE_ASSISTANT_FILE_SUMMARY_NEAR_MISS_TOP_K=3
# In-dialog session memory (thread state + semantic search + LLM resolver; no phrase triggers)
SESSION_CONTEXT_ENABLED=true
SESSION_CONTEXT_SEMANTIC_ENABLED=true
SESSION_CONTEXT_RESOLVER_ENABLED=true
SESSION_CONTEXT_THREAD_STATE_LLM_ENABLED=true
SESSION_CONTEXT_SEARCH_K=8
SESSION_CONTEXT_MAX_RELEVANT_TURNS=5
# HTTP intent layer уступает Turn Context Contract при referential follow-up
SESSION_CONTEXT_INTENT_AUTHORITY_ENABLED=true
SESSION_CONTEXT_INTENT_AUTHORITY_MIN_CONF=0.72
# Turn Context Contract — primary LLM judge (memory vs scoped vs full retrieval)
TURN_CONTEXT_LLM_JUDGE_ENABLED=true
# Пусто = fallback TURN_CONTEXT_LLM_QUERY_MODEL → CASE_ASSISTANT_ROUTER_MODEL
TURN_CONTEXT_LLM_JUDGE_MODEL=
TURN_CONTEXT_LLM_JUDGE_MAX_TOKENS=384
TURN_CONTEXT_LLM_JUDGE_MIN_CONF=0.68
TURN_CONTEXT_LLM_JUDGE_MAX_TURNS=10
# Turn Context Contract — LLM-lite deictic query expansion (Phase 2 fallback)
TURN_CONTEXT_LLM_QUERY_RESOLVE_ENABLED=true
# Пусто = fallback на CASE_ASSISTANT_ROUTER_MODEL
TURN_CONTEXT_LLM_QUERY_MODEL=
TURN_CONTEXT_LLM_QUERY_MAX_TOKENS=256
# Recall + rerank в одном executor (без cold gap между graph nodes)
CASE_ASSISTANT_UNIFIED_RETRIEVAL=true
# Async persist + in-process write-through buffer (Session Resolver reads buffer until Neon commit)
ASSISTANT_ASYNC_PERSIST_ENABLED=true
ASSISTANT_PERSIST_WRITETHROUGH_BUFFER_ENABLED=true
ASSISTANT_PERSIST_WRITETHROUGH_MAX_TURNS=10
# Минимальный score семантического поиска по сессии для clarify/replay (0–1)
SESSION_REPLAY_SEARCH_SCORE_MIN=0.45
# Сколько последних сообщений класть в промпт global assistant (replay/search отдельно)
GLOBAL_ASSISTANT_HISTORY_PROMPT_MAX_TURNS=16
GLOBAL_ASSISTANT_HISTORY_PROMPT_MAX_CHARS=6400
GLOBAL_ASSISTANT_HISTORY_SUMMARIZE_AFTER_TURNS=20
GLOBAL_ASSISTANT_CHECKPOINT_MESSAGES_ENABLED=true
GLOBAL_ASSISTANT_TRANSCRIPT_REPLAY_ENABLED=false
# Case graph: не резать историю до summary, пока не длиннее порога
CASE_GRAPH_MEMORY_KEEP_LAST_N=12
CASE_GRAPH_MEMORY_SUMMARIZE_THRESHOLD=24
CASE_GRAPH_MEMORY_MAX_TOKENS=8000
# Lite-секретарь только при провале summary-index (не на каждый вопрос)
CASE_ASSISTANT_LLM_ROUTER_FALLBACK_ENABLED=true
# In-memory BM25: prewarm из PGVector в процессе API (обязательно при FILE_PROCESSING_MODE=local)
CASE_BM25_PREWARM_ENABLED=true
CASE_BM25_MAX_CHUNKS=2500
# Слияние фоновых BM25 rebuild после серии store (сек)
CASE_BM25_DEBOUNCE_SEC=1.5
# false — не блокировать гибридный поиск построением BM25 (FTS + фоновый prewarm)
# CASE_BM25_SYNC_ON_HYBRID_SEARCH=true
CASE_ASSISTANT_RECALL_K=100
CASE_ASSISTANT_FINAL_K=15
CASE_ASSISTANT_RERANK_ENABLED=true
CASE_ASSISTANT_RERANK_MAX_CHARS=1200
CASE_ASSISTANT_MICRO_ONLY_RECALL_ENABLED=true
CASE_ASSISTANT_MICRO_RECALL_K=20
CASE_ASSISTANT_PARENT_CONTEXT_ENABLED=true
CASE_ASSISTANT_RERANK_BATCH_SIZE=32
CASE_ASSISTANT_RERANK_USE_COHERE=false
# Tabular review: per-file retrieval budget (one file_id scope, not whole case)
# Rerank: TABULAR_RERANK_ENABLED (same cross-encoder stack as case assistant)
TABULAR_RERANK_ENABLED=true
# Tabular: max parallel cell extractions per column run
TABULAR_MAX_PARALLEL_CELLS=5
TABULAR_RECALL_K=30
TABULAR_FINAL_K=8
TABULAR_FINAL_K_SIMPLE=8
TABULAR_CONTEXT_MAX_CHARS=12000
# Max verified clause-boundary hits that bypass rerank → model (1..5); merged with rerank pool
CLAUSE_ANCHOR_MAX_PINS=3
TABULAR_EVIDENCE_REQUIRED=true
# Quote→answer: locate grounded supporting quote, then derive cell_value from quote only
TABULAR_QUOTE_THEN_ANSWER=false
# Heavy reranker (deep tier); fast/standard — CASE_ASSISTANT_RERANK_LIGHT_* ниже
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Adaptive execution tiers: recall/rerank по глубине запроса (откат: ADAPTIVE_TIER_ENABLED=false)
CASE_ASSISTANT_ADAPTIVE_TIER_ENABLED=true
# FAST path: document Q&A (+ практика) без prep-LLM; HEAVY только draft/deep/127-ФЗ и тяжёлые интенты
CASE_ASSISTANT_LATENCY_PATH_ENABLED=true
# Weak retrieval → one deterministic broaden/deepen pass (no LLM on FAST)
CASE_ASSISTANT_RETRIEVAL_ESCALATION_ENABLED=true
# Scoped file deepen: lexical within-file channel for compact docs
CASE_ASSISTANT_SCOPED_FILE_EXPAND_ENABLED=true
CASE_ASSISTANT_SCOPED_FILE_EXPAND_MAX_CHUNKS=48
CASE_ASSISTANT_SCOPED_FILE_EXPAND_POOL=32
CASE_ASSISTANT_SCOPED_FILE_EXPAND_MAX_FILES=3
# FAST keeps rerank off by default (light rerank hurt SHAK golden hit-rate)
# CASE_ASSISTANT_RERANK_LIGHT_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CASE_ASSISTANT_INSTANT_RECALL_K=16
CASE_ASSISTANT_STANDARD_RECALL_K=35
CASE_ASSISTANT_STANDARD_MAX_RETRIEVAL_ROUNDS=1
CASE_ASSISTANT_MAX_RETRIEVAL_ROUNDS=2
CASE_ASSISTANT_RERANK_POOL_CAP=24
CASE_ASSISTANT_SKIP_RERANK_WHEN_SUFFICIENT=true
CASE_ASSISTANT_SKIP_RERANK_MIN_RANK_GAP=0.12
CASE_ASSISTANT_OVERVIEW_SUMMARY_PATH_ENABLED=true
CASE_ASSISTANT_RERANK_LIGHT_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CASE_ASSISTANT_RERANK_LIGHT_MAX_CHARS=900
CASE_ASSISTANT_RERANK_LIGHT_BATCH_SIZE=64
CASE_ASSISTANT_DEEP_MAX_RETRIEVAL_ROUNDS=3
# СПРАВОЧНИК: norm-only (статья/акт без материалов дела) — один раунд, без case RAG
CASE_ASSISTANT_LEGAL_NORM_ONLY_ENABLED=true
CASE_ASSISTANT_LEGAL_NORM_MAX_RETRIEVAL_ROUNDS=1
CASE_ASSISTANT_GRAPH_RECURSION_LIMIT=40
CASE_ASSISTANT_TIER_LLM_ENABLED=false
CASE_ASSISTANT_TIER_CLASSIFIER_MODEL=yandexgpt-lite/latest
CASE_ASSISTANT_STREAM_CASE_CHAT=true

# Draft Mode: bulk fill (1 RAG + unified LLM) + BM25/hybrid для дел
DRAFT_TEMPLATE_INDEX_ON_UPLOAD=true
DRAFT_TEMPLATE_INDEXER_VERSION=1
DRAFT_BULK_FILL_ENABLED=true
DRAFT_BULK_TARGETED_RETRY_ENABLED=true
DRAFT_BULK_RAG_K=14
DRAFT_BULK_RAG_STRATEGY=hybrid
DRAFT_BULK_CONTEXT_MAX_CHARS=20000
DRAFT_BULK_UNIFIED_MAX_FIELDS_PER_CALL=48
DRAFT_BULK_MIN_CONFIDENCE=0.25
DRAFT_BULK_RETRY_MAX_FIELDS=4
DRAFT_BULK_RETRY_MIN_SHARED_CHARS=800
DRAFT_BULK_RETRY_LIGHT_RAG_ENABLED=true
DRAFT_BULK_RETRY_RAG_K=5
DRAFT_SKIP_PREFETCH_RAG_WHEN_CATALOG_FILL=true
DRAFT_PER_FIELD_RAG_ENABLED=true
DRAFT_FIELD_FINAL_K=5
DRAFT_FIELD_RAG_MAX_PARALLEL=4
DRAFT_FIELD_BATCH_SIZE=8
DRAFT_FULL_HTML_FALLBACK_ENABLED=false
DRAFT_PLAN_FIELD_PROBE_COUNT=5
# true = сначала план + кнопка одобрения; false = сразу генерация документа (по умолчанию)
DRAFT_PLAN_APPROVAL_ENABLED=false

# LangGraph case-chat: structured citations (chunk_id→[N]); default on in config.py
# RAG_LANGGRAPH_STRUCTURED_CITATIONS_ENABLED=false
# Stream structured-citation answers (text_delta + progressive citations); default on
RAG_STRUCTURED_CITATIONS_STREAM_ENABLED=true
# Потоковая отдача ответов в чате редактора документа (Yandex OpenAI-compat stream=true).
EDITOR_CHAT_STREAM_ENABLED=true
# Подробная телеметрия: лог [EditorLatency], SSE latency_debug, Langfuse editor_turn_latency_summary
EDITOR_LATENCY_VERBOSE=true
# Скрепка в редакторе: до 3 файлов целиком (structured_text из БД), без RAG
EDITOR_ATTACH_FULL_TEXT_ENABLED=true
EDITOR_ATTACH_MAX_FILES=3
EDITOR_ATTACH_MAX_CHARS_PER_FILE=80000
EDITOR_ATTACH_MAX_CHARS_TOTAL=120000
FILE_STRUCTURED_TEXT_MAX_STORE_CHARS=2000000
# Редактор: trim без LLM-summary в manage_memory (быстрее первый токен)
EDITOR_FAST_MEMORY_PATH=true
# Прогрев compile LangGraph при старте API
CHAT_GRAPH_WARMUP_ON_STARTUP=true

# Yandex Vision: макс. страниц PDF за один запрос (квота сервиса, обычно 200)
YANDEX_VISION_MAX_PDF_PAGES=200

# Langfuse Cloud (observability + prompt management + evals)
# Включите для детальной трассировки внутреннего ассистента (timeline + spans).
# pip install -r backend/requirements-core.txt  # включает langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 0.0..1.0 (1.0 = трассировать все запросы)
LANGFUSE_SAMPLE_RATE=1.0
# Пошаговые spans assistant.{case|global}.* (HTTP prep, orchestrator, session context, graph prep, persist)
ASSISTANT_PIPELINE_LANGFUSE_DETAILED=true
CASE_ASSISTANT_LANGFUSE_DETAILED=true
# Управление версиями промптов в Langfuse
LANGFUSE_PROMPT_LABEL=production
# 0 = использовать label, >0 = зафиксировать конкретную версию
LANGFUSE_PROMPT_VERSION=0
# LegalChunkerV2 (macro/micro) для всех документов
LEGAL_CHUNKING_DUAL_ENABLED=true
# PDF: при отсутствии текстового слоя — Yandex OCR new API (model=page + bbox)
PDF_OCR_PREFER_YANDEX=true
YANDEX_OCR_SCAN_MODEL=page
YANDEX_OCR_TABLE_MODEL=page
YANDEX_OCR_PDF_ASYNC_MODEL=page
YANDEX_VISION_MAX_PDF_PAGES=300
# До 200 стр. в одном recognizeTextAsync (лимит Yandex); чанки только если PDF >9 МБ
YANDEX_OCR_ASYNC_MAX_PAGES_PER_REQUEST=200
# false = один запрос на весь PDF; true = параллель только при нескольких чанках
YANDEX_OCR_ASYNC_PARALLEL_ENABLED=false
YANDEX_OCR_ASYNC_MAX_PARALLEL_CHUNKS=5
# HTTP read timeout (сек) для POST recognizeTextAsync / GET getRecognition
YANDEX_OCR_HTTP_START_TIMEOUT_SEC=180
YANDEX_OCR_HTTP_POLL_TIMEOUT_SEC=120
# Первая пауза перед poll getRecognition (сек); 2 — баланс latency/лишних GET
YANDEX_OCR_ASYNC_INITIAL_POLL_DELAY_SEC=2.0
YANDEX_OCR_MIN_START_INTERVAL_SEC=0.12
YANDEX_OCR_MIN_POLL_INTERVAL_SEC=0
# Локальный fallback для скана: tesseract (PyMuPDF) | docling_easyocr (тяжёлый; только для экспериментов)
PDF_SCAN_OCR_ENGINE=tesseract
# Эвристика качества OCR (минимум символов на страницу с текстом)
PDF_OCR_MIN_EXPECTED_CHARS_PER_PAGE=20
# Upload limit for case files (MB). Raise for long bank statements / multi-hundred-page PDFs.
MAX_FILE_SIZE_MB=30
# Docling advanced tuning (pipeline/chunking/limits)
DOCLING_MAX_PAGES_PER_DOC=2000
DOCLING_MAX_FILE_SIZE_BYTES=104857600
# Page-batched Docling for large PDFs (weak VM safe: never one-shot 500 pages)
DOCLING_PDF_BATCH_ENABLED=true
DOCLING_PDF_BATCH_PAGES=30
DOCLING_PDF_BATCH_MIN_PAGES=40
# Для offline/air-gapped окружений (опционально):
# DOCLING_ARTIFACTS_PATH=/opt/docling/models
DOCLING_ARTIFACTS_PATH=
DOCLING_ENABLE_REMOTE_SERVICES=false
DOCLING_PDF_TABLE_STRUCTURE=true
DOCLING_PDF_TABLE_CELL_MATCHING=true
# accurate|fast
DOCLING_PDF_TABLE_MODE=accurate
# false: для PDF с текстовым слоём LegalChunkerV2 сам отключает OCR в Docling (только layout/таблицы).
# true на всех PDF сильно замедляет обработку (как file «04» ~5 мин на VM).
DOCLING_OCR_FORCE_FULL_PAGE=false
DOCLING_OCR_BITMAP_AREA_THRESHOLD=0.05
# auto | easyocr | tesseract_cli — только fallback OCR внутри Docling (сканы без Yandex); для native PDF не используется
DOCLING_PDF_OCR_ENGINE=auto
DOCLING_OCR_EASYOCR_LANGS=ru,en
DOCLING_OCR_TESSERACT_LANGS=rus,eng
# Только для DOCLING_PDF_OCR_ENGINE=auto (формат зависит от выбранного Docling-движка)
DOCLING_OCR_LANGUAGES=
DOCLING_CHUNK_MAX_TOKENS=512
DOCLING_CHUNK_MERGE_PEERS=true
DOCLING_CHUNK_REPEAT_TABLE_HEADER=true
# markdown|triplet (для юрдоков обычно лучше markdown)
DOCLING_CHUNK_TABLE_SERIALIZER=markdown
DOCLING_CHUNK_MARKDOWN_COMPACT_TABLES=true
# Опционально: привязать бюджет токенов chunker к конкретному HF токенизатору
DOCLING_CHUNK_TOKENIZER_MODEL=

# Chunking budgets (safety limits)
# budget <= 0 means "no truncation"
LEGAL_CHUNKING_BUDGET_MAX_TOTAL_CHUNKS=4000
# Optional override for GLOBAL_LEGAL_CORPUS indexing
LEGAL_CORPUS_BUDGET_MAX_TOTAL_CHUNKS=8000
# OCR: ретраи, троттлинг и языки распознавания
YANDEX_OCR_MAX_RETRIES=3
YANDEX_OCR_MIN_REQUEST_INTERVAL_SEC=1.1
YANDEX_OCR_LANGUAGE_CODES=ru,en
YANDEX_OCR_DATA_LOGGING_ENABLED=true

# Yandex AI Studio classifier (optional)
# Format: gpt://<folder-id>/<classifier-name>/<version> (or your org's URI)
YANDEX_CLASSIFIER_MODEL_URI=

# Excel: таблица → PDF → Yandex Vision OCR (иначе только openpyxl)
XLSX_OCR_VIA_PDF_YANDEX=true
XLSX_PDF_MAX_ROWS_PER_SHEET=6000
XLSX_PDF_MAX_COLS=32
# Опционально: путь к .ttf с кириллицей для генерации PDF (Linux: DejaVu)
# XLSX_PDF_FONT_TTF=

# Deep agent runs (Legora-style orchestration)
AGENT_RUNS_ENABLED=true
AGENT_RUNS_CHECKPOINTER_ENABLED=true
AGENT_RUNS_RECURSION_LIMIT=50
AGENT_RUNS_TOOL_CALL_RUN_LIMIT=32
AGENT_RUNS_MODEL_CALL_RUN_LIMIT=48
AGENT_RUNS_TOOL_TIMEOUT_SEC=120
AGENT_RUNS_DRAFT_TOOL_ENABLED=true
AGENT_RUNS_DRAFT_TOOL_TIMEOUT_SEC=900
# AGENT_RUNS_INTERRUPT_ON_TOOLS=agent_draft
# AGENT_RUNS_SYSTEM_PROMPT=
AGENT_RUNS_WORKER_ENABLED=true
AGENT_RUNS_WORKER_POLL_SEC=0.5
AGENT_RUNS_SSE_IDLE_SEC=600

# Frontend (Vite envDir = корень репозитория)
VITE_API_URL=http://127.0.0.1:8000
# Deep agent / Workflows UI (см. также VITE_FEATURE_AGENT_RUNS)
VITE_AGENT_RUNS_ENABLED=true
# Product surface (default true when unset — local dev). VM prod: see .env.vm-ui
# UI surface (build-time). Defaults: чат-тумблеры НПА/практики on; страницы и сайдбар — off.
# Prod overlay: .env.vm-ui (merged at deploy). Включить всё локально — раскомментируйте:
# VITE_FEATURE_LEGAL_CORPUS=true
# VITE_FEATURE_LEGAL_CORPUS_PAGES=true
# VITE_FEATURE_COURT_PRACTICE=true
# VITE_FEATURE_COURT_PRACTICE_PAGES=true
# VITE_FEATURE_DRAFT_TEMPLATES=true
# VITE_FEATURE_DRAFT_MODE=true
# VITE_FEATURE_EDITOR=true
# VITE_FEATURE_PLAYBOOKS=true
# VITE_FEATURE_AGENT_RUNS=true
# VITE_FEATURE_CHUNK_LAB=true
